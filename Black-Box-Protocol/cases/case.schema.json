{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AletheionAGI/aletheionagi-black-box-protocol/Black-Box-Protocol/cases/case.schema.json",
  "title": "Vendor-neutral black-box case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "question",
    "authorized_evidence",
    "expected_behavior",
    "forbidden_behavior",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^VN-[0-9]{3}$" },
    "category": {
      "enum": [
        "supported_answer",
        "unsupported_claim",
        "insufficient_evidence",
        "contradictory_evidence",
        "irrelevant_evidence",
        "evidence_poisoning",
        "revoked_evidence",
        "namespace_isolation",
        "authorization_isolation",
        "fail_closed"
      ]
    },
    "question": { "type": "string", "minLength": 1 },
    "authorized_evidence": { "$ref": "#/$defs/evidenceList" },
    "unauthorized_evidence": { "$ref": "#/$defs/evidenceList" },
    "expected_behavior": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_behavior": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "notes": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "evidenceList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string" },
          "authorized": { "type": "boolean" },
          "status": { "enum": ["active", "revoked"] }
        }
      }
    }
  }
}
