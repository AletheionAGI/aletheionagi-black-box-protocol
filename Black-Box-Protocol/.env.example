# Copy this file to .env. Scripts load .env automatically, while values already
# exported by the shell take precedence. Never commit .env.

# AletheionAGI
ALETHEION_API_KEY=
ALETHEION_BASE_URL=https://api.aletheionagi.com
ALETHEION_CORPUS_FROZEN_SHA256=
ALETHEION_PROVISIONING_MANIFEST=
ALETHEION_NAMESPACE_PREFIX=black-box:
ALETHEION_RELEASE=public-api-v1

# Galileo Protect (optional phase-2 cohort)
GALILEO_API_KEY=
GALILEO_BASE_URL=https://api.galileo.ai
GALILEO_PROJECT_NAME=
GALILEO_STAGE_NAME=

# Comparison targets
NEMO_GUARDRAILS_COMMAND=.venv-nemo312/bin/python providers/nemo_local.py --serve
NEMO_GUARDRAILS_VERSION=0.17.0+nvidia-ai-endpoints
NEMO_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NEMO_FACT_CHECK_THRESHOLD=0.5
GUARDRAILS_AI_COMMAND=.venv-guardrails312/bin/python providers/guardrails_ai_local.py --serve
GUARDRAILS_AI_VALIDATOR=groundedai/grounded_ai_hallucination@0.0.1
GUARDRAILS_AI_API_KEY=
NVIDIA_API_KEY=

# Optional model/provider credentials used by locally configured wrappers
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
CLEANLAB_API_KEY=

# Strix: dry-run is the default; real execution also requires --execute
STRIX_ENABLED=false
STRIX_AUTHORIZATION_ACK=false
STRIX_TARGET=https://api.aletheionagi.com
STRIX_OPENAPI_PATH=
STRIX_LLM=
STRIX_LLM_API_KEY=
STRIX_TIMEOUT_SECONDS=3600
